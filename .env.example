# ==============================================================================
# HB+ Fit Workspace - Environment Configuration
# ==============================================================================

# Permitted organization domain (default: hbplus.fit)
EXPO_PUBLIC_ALLOWED_DOMAIN=hbplus.fit

# Authorized administrator accounts (comma separated)
EXPO_PUBLIC_ADMIN_EMAILS=admin@hbplus.fit,kaif@hbplus.fit

# Optional: Live Supabase / Google OAuth Credentials
# If omitted or unconfigured, the application runs with full domain validation in sandbox mode.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
